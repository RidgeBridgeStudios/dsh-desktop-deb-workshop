[Unit]
Description=DeepSeek Harness Daemon (DSH Desktop)
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/dsh-desktop-daemon
Restart=on-failure
RestartSec=5
Environment=PATH=%h/.dsh/.desktop-bin:/usr/local/bin:/usr/bin:/bin:%h/.local/bin
SyslogIdentifier=dsh-desktop
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
