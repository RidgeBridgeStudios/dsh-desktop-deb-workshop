#!/usr/bin/env bash
set -e

case "$1" in
    configure)
        # Determine the invoking non-root user
        TARGET_USER="${SUDO_USER:-}"
        if [ -z "$TARGET_USER" ] || [ "$TARGET_USER" = "root" ]; then
            # If run directly as root, identify the first non-root interactive user (UID >= 1000)
            TARGET_USER=$(awk -F: '$3 >= 1000 && $3 < 65534 && $6 ~ /^\/home/ {print $1; exit}' /etc/passwd || echo "")
        fi

        if [ -n "$TARGET_USER" ] && id -u "$TARGET_USER" >/dev/null 2>&1; then
            USER_HOME=$(getent passwd "$TARGET_USER" | cut -d: -f6)
            USER_UID=$(id -u "$TARGET_USER")
            USER_GID=$(id -g "$TARGET_USER")

            # 1. Create ~/.dsh/profiles/default/ if missing
            DEFAULT_PROFILE_DIR="$USER_HOME/.dsh/profiles/default"
            mkdir -p "$DEFAULT_PROFILE_DIR"
            mkdir -p "$USER_HOME/.local/share/dsh-desktop"

            # 2. Write a minimal valid package.json before running pnpm
            PACKAGE_JSON="$DEFAULT_PROFILE_DIR/package.json"
            if [ ! -f "$PACKAGE_JSON" ]; then
                cat << 'EOF' > "$PACKAGE_JSON"
{
  "name": "dsh-profile-default",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {},
  "dsh": {
    "profile": {
      "bundles": [
        "@deepseek-ai/dsh-base",
        "@deepseek-ai/dsh-web-app"
      ],
      "patchReload": "live"
    }
  }
}
EOF
                chown "$USER_UID:$USER_GID" "$PACKAGE_JSON"
            fi
            WORKSPACE_YAML="$DEFAULT_PROFILE_DIR/pnpm-workspace.yaml"
            if [ ! -f "$WORKSPACE_YAML" ]; then
                cat << 'EOF' > "$WORKSPACE_YAML"
packages:
  - .

nodeLinker: hoisted
autoInstallPeers: false
EOF
                chown "$USER_UID:$USER_GID" "$WORKSPACE_YAML"
            fi
            chown "$USER_UID:$USER_GID" "$USER_HOME/.dsh" 2>/dev/null || true
            chown -R "$USER_UID:$USER_GID" "$DEFAULT_PROFILE_DIR"
            chown -R "$USER_UID:$USER_GID" "$USER_HOME/.local/share/dsh-desktop"

            # 3. Enable user lingering for the invoking user (opt-in only: dsh-desktop is a desktop app, not a background daemon)
            if [ -f /etc/dsh-desktop/linger-enabled ] && command -v loginctl >/dev/null 2>&1; then
                loginctl enable-linger "$TARGET_USER" 2>/dev/null || true
            fi

            # 4. Enable and (re)start the user service
            USER_RUNDIR="/run/user/$USER_UID"
            if [ -d "$USER_RUNDIR" ] && command -v systemctl >/dev/null 2>&1; then
                runuser -u "$TARGET_USER" -- env XDG_RUNTIME_DIR="$USER_RUNDIR" systemctl --user daemon-reload 2>/dev/null || true
                runuser -u "$TARGET_USER" -- env XDG_RUNTIME_DIR="$USER_RUNDIR" systemctl --user enable --now dsh-desktop.service 2>/dev/null || true
                # Best-effort early market seed; idempotent across runs
                runuser -u "$TARGET_USER" -- env XDG_RUNTIME_DIR="$USER_RUNDIR" \
                  node /usr/share/dsh-desktop/lib/plugin-manager/bootstrap-cli.mjs \
                  >/dev/null 2>&1 || true
            fi

            # Clean up stale user desktop entry if it pointed to dsh-native
            USER_DESKTOP_ENTRY="$USER_HOME/.local/share/applications/dsh-desktop.desktop"
            if [ -f "$USER_DESKTOP_ENTRY" ] && grep -q "dsh-native" "$USER_DESKTOP_ENTRY" 2>/dev/null; then
                rm -f "$USER_DESKTOP_ENTRY"
                su - "$TARGET_USER" -c "update-desktop-database ~/.local/share/applications" 2>/dev/null || true
            fi

            echo "Notice: First launch will complete default profile setup."
        fi

        # 5. Update the desktop, MIME, and icon databases
        if command -v update-desktop-database >/dev/null 2>&1; then
            update-desktop-database /usr/share/applications/ || true
        fi
        if command -v update-mime-database >/dev/null 2>&1; then
            update-mime-database /usr/share/mime || true
        fi
        if command -v update-icon-caches >/dev/null 2>&1; then
            update-icon-caches /usr/share/icons/hicolor 2>/dev/null || true
        elif command -v gtk-update-icon-cache >/dev/null 2>&1; then
            gtk-update-icon-cache -q /usr/share/icons/hicolor 2>/dev/null || true
        fi

        # 6. Load AppArmor profile (required on Ubuntu 24.04+ where
        # kernel.apparmor_restrict_unprivileged_userns=1 blocks Electron's
        # Chromium zygote from creating unprivileged user namespaces).
        # Uses command -v rather than -x /usr/sbin/ to handle merged-/usr layouts.
        # A load failure warns loudly but does not abort dpkg configure.
        if command -v apparmor_parser >/dev/null 2>&1 && \
           [ -f /etc/apparmor.d/usr.bin.dsh-desktop ]; then
            if ! apparmor_parser -r /etc/apparmor.d/usr.bin.dsh-desktop; then
                echo "dsh-desktop: warning: AppArmor profile failed to load." >&2
                echo "dsh-desktop: warning: Electron sandbox may fail on Ubuntu 24.04+." >&2
                echo "dsh-desktop: warning: run 'apparmor_parser -r /etc/apparmor.d/usr.bin.dsh-desktop' for details." >&2
            fi
        fi

        # 7. Symlink binaries into /usr/bin
        for bin in dsh-desktop dsh-desktop-daemon dsh-desktop-upgrade-helper; do
            src="/usr/lib/dsh-desktop/bin/$bin"
            if [ ! -f "$src" ]; then
                echo "dsh-desktop: error: $src is missing from the package." >&2
                exit 1
            fi
            ln -sf "$src" "/usr/bin/$bin"
        done
        ;;
esac

exit 0
