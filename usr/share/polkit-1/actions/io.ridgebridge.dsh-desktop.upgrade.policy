<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>RidgeBridgeStudios</vendor>
  <vendor_url>https://github.com/RidgeBridgeStudios/dsh-desktop-deb-workshop</vendor_url>

  <action id="io.ridgebridge.dsh-desktop.upgrade">
    <description>Upgrade DSH Desktop package</description>
    <message>Authentication is required to upgrade DSH Desktop</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/dsh-desktop/bin/dsh-desktop-upgrade-helper</annotate>
  </action>
</policyconfig>
